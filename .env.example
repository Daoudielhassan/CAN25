# AFCON 2025 Chatbot - Environment Configuration
# Copy this file to .env and fill in your values

# ======================
# LLM Configuration
# ======================
# Get your Groq API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ======================
# Redis Configuration
# ======================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ======================
# Server Configuration
# ======================
# Refresh interval for live match updates (seconds)
REFRESH_INTERVAL=30

# Vector store path
VECTOR_STORE_PATH=data/vector_store/afcon_vectorstore

# ======================
# Optional: Alternative LLM
# ======================
# If you want to use OpenAI instead of Groq, uncomment and set:
# OPENAI_API_KEY=your_openai_key_here

# ======================
# Optional: Google Gemini
# ======================
# If you want to use Google Gemini, uncomment and set:
# GOOGLE_API_KEY=your_google_api_key_here

# ======================
# Deployment Settings
# ======================
# Set to 'production' for deployment, 'development' for local
ENVIRONMENT=development

# Server host and port
HOST=0.0.0.0
PORT=8000
